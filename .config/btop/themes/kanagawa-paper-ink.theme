# Kanagawa Paper Ink theme for btop
# Based on https://github.com/thesimonho/kanagawa-paper.nvim

# Main background
theme[main_bg]="#1F1F28"

# Main text color
theme[main_fg]="#DCD7BA"

# Title color for boxes
theme[title]="#c4b28a"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#c4b28a"

# Background color of selected item in processes box
theme[selected_bg]="#363646"

# Foreground color of selected item in processes box
theme[selected_fg]="#DCD7BA"

# Color of inactive/disabled text
theme[inactive_fg]="#727169"

# Misc colors for processes box
theme[proc_misc]="#C8C093"

# Box outline colors
theme[cpu_box]="#859fac"
theme[mem_box]="#699469"
theme[net_box]="#8ea49e"
theme[proc_box]="#a292a3"

# Box divider line and small boxes line color
theme[div_line]="#2A2A37"

# Temperature graph colors (cool → warm)
theme[temp_start]="#699469"
theme[temp_mid]="#c4b28a"
theme[temp_end]="#c4746e"

# CPU graph colors
theme[cpu_start]="#859fac"
theme[cpu_mid]="#c4b28a"
theme[cpu_end]="#c4746e"

# Mem/Disk free meter
theme[free_start]="#699469"
theme[free_mid]="#c4b28a"
theme[free_end]="#c4746e"

# Mem/Disk cached meter
theme[cached_start]="#8ea49e"
theme[cached_mid]="#859fac"
theme[cached_end]="#a292a3"

# Mem/Disk available meter
theme[available_start]="#699469"
theme[available_mid]="#c4b28a"
theme[available_end]="#c4746e"

# Mem/Disk used meter
theme[used_start]="#699469"
theme[used_mid]="#c4b28a"
theme[used_end]="#c4746e"

# Download graph colors
theme[download_start]="#8ea49e"
theme[download_mid]="#859fac"
theme[download_end]="#a292a3"

# Upload graph colors
theme[upload_start]="#6A9589"
theme[upload_mid]="#859fac"
theme[upload_end]="#8992a7"
