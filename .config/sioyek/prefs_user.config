# For more information see the documentation at https://sioyek-documentation.readthedocs.io/
startup_commands    toggle_dark_mode

check_for_updates_on_startup	0
use_legacy_keybinds 0

# background = #1F1F28 (sumi-ink-3, kanagawa-paper-ink's ui.bg)
background_color                0.12 0.12 0.16
dark_mode_background_color      0.12 0.12 0.16
dark_mode_contrast              0.85

# foreground = #DCD7BA (fuji-white) | cursor = #c4b28a (dragon-yellow)
text_highlight_color            0.77 0.70 0.54

# selection-background = #363646 (sumi-ink-5, ui.bg_visual)
visual_mark_color               0.21 0.21 0.27 0.6

# dragon-green for search
search_highlight_color          0.41 0.58 0.41

# dragon-blue-2 for links (matches ink theme's syn.fun)
link_highlight_color            0.52 0.62 0.67

# dragon-red for synctex
synctex_highlight_color         0.77 0.45 0.43

# status bar — background #1F1F28, foreground #DCD7BA
status_bar_color                0.12 0.12 0.16
status_bar_text_color           0.86 0.84 0.73
status_bar_font_size            16

page_separator_width            1
# sumi-ink-4 (ui.bg_p1, one step lighter than the page background)
page_separator_color            0.16 0.16 0.22

search_url_s	https://scholar.google.com/scholar?q=
search_url_l	http://gen.lib.rus.ec/scimag/?q=
search_url_g	https://www.google.com/search?q=

middle_click_search_engine			s
shift_middle_click_search_engine	l

zoom_inc_factor         1.2
vertical_move_amount    1.0
horizontal_move_amount    1.0
move_screen_ratio      0.5
flat_toc                            0
should_use_multiple_monitors        0
should_load_tutorial_when_no_other_file	1
should_launch_new_instance				0
should_launch_new_window				0
visual_mark_next_page_fraction	0.75
visual_mark_next_page_threshold	0.25
should_draw_unrendered_pages	0
rerender_overview 1
default_dark_mode	0
sort_bookmarks_by_location	1
wheel_zoom_on_cursor 0
fit_to_page_width_ratio 0.75
collapsed_toc 0
ruler_mode 1
ruler_padding 1.0
ruler_x_padding 5.0
create_table_of_contents_if_not_exists 1
max_created_toc_size 5000
should_warn_about_user_key_override 1
single_click_selects_words 0
multiline_menus 1
prerender_next_page_presentation 1

# Highlight colors mapped to the Kanagawa Paper Ink palette.
# 26 distinct hues (no two letters share an RGB triplet), drawn mostly from
# the "dragon" (ink) family with a few "canvas" (paper) tones filling hue gaps,
# arranged warm -> cool -> violet/neutral so nearby letters read as a spectrum.
# a = dragon-red
highlight_color_a    0.77 0.45 0.43
# b = canvas-red-1 (paper-toned red)
highlight_color_b    0.76 0.46 0.45
# c = dragon-orange
highlight_color_c    0.71 0.57 0.48
# d = dragon-orange-2
highlight_color_d    0.62 0.46 0.40
# e = dragon-yellow
highlight_color_e    0.77 0.70 0.54
# f = boat-yellow-2
highlight_color_f    0.75 0.64 0.43
# g = dragon-green
highlight_color_g    0.41 0.58 0.41
# h = dragon-green-2
highlight_color_h    0.54 0.60 0.48
# i = canvas-green-1
highlight_color_i    0.49 0.58 0.47
# j = dragon-aqua
highlight_color_j    0.56 0.64 0.62
# k = canvas-aqua-1
highlight_color_k    0.48 0.58 0.56
# l = canvas-teal-1
highlight_color_l    0.49 0.56 0.69
# m = dragon-blue
highlight_color_m    0.40 0.52 0.58
# n = dragon-blue-3
highlight_color_n    0.44 0.56 0.62
# o = dragon-blue-2
highlight_color_o    0.52 0.62 0.67
# p = dragon-blue-4
highlight_color_p    0.36 0.48 0.53
# q = dragon-teal
highlight_color_q    0.58 0.62 0.71
# r = dragon-violet
highlight_color_r    0.54 0.57 0.65
# s = spring-violet-1
highlight_color_s    0.58 0.54 0.66
# t = wave-aqua-1
highlight_color_t    0.42 0.58 0.54
# u = oni-violet-2
highlight_color_u    0.72 0.71 0.82
# v = dragon-pink
highlight_color_v    0.64 0.57 0.64
# w = sakura-pink
highlight_color_w    0.82 0.49 0.60
# x = old-white (lighter text)
highlight_color_x    0.78 0.75 0.58
# y = dragon-gray-2
highlight_color_y    0.62 0.61 0.58
# z = katana-gray
highlight_color_z    0.44 0.49 0.49
