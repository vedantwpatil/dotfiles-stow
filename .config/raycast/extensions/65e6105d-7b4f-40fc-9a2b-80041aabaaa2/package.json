{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "remove-paywall",
  "title": "Remove Paywall",
  "description": "Remove the paywall from the selected or clipboard URL.",
  "icon": "command-icon.png",
  "author": "tegola",
  "contributors": [
    "Whitespace",
    "DannySeidel",
    "artivilla",
    "maxoliinyk",
    "0xdhrv",
    "xilopaint",
    "alexi.build"
  ],
  "categories": [
    "Web"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "remove-paywall",
      "title": "Remove Paywall",
      "description": "Remove the paywall from the selected or clipboard URL.",
      "shortcut": {
        "macOS": {
          "modifiers": [
            "cmd"
          ],
          "key": "o"
        },
        "Windows": {
          "modifiers": [
            "ctrl"
          ],
          "key": "o"
        }
      },
      "mode": "no-view",
      "arguments": [
        {
          "name": "url",
          "type": "text",
          "placeholder": "URL (or selection/clipboard)",
          "required": false
        },
        {
          "name": "service",
          "type": "dropdown",
          "placeholder": "Service",
          "required": false,
          "data": [
            {
              "title": "archive.is",
              "value": "https://archive.is"
            },
            {
              "title": "removepaywall.com",
              "value": "https://www.removepaywall.com"
            },
            {
              "title": "freedium-mirror.cfd",
              "value": "https://freedium-mirror.cfd"
            }
          ]
        }
      ]
    },
    {
      "name": "remove-paywall-current-tab",
      "title": "Remove Paywall from Current Tab",
      "description": "Remove the paywall from the URL in your active browser tab.",
      "shortcut": {
        "macOS": {
          "modifiers": [
            "cmd",
            "shift"
          ],
          "key": "o"
        },
        "Windows": {
          "modifiers": [
            "ctrl",
            "shift"
          ],
          "key": "o"
        }
      },
      "mode": "no-view"
    },
    {
      "name": "remove-paywall-clipboard",
      "title": "Remove Paywall from Clipboard",
      "description": "Remove the paywall from a clipboard URL.",
      "shortcut": {
        "macOS": {
          "modifiers": [
            "cmd",
            "shift"
          ],
          "key": "c"
        },
        "Windows": {
          "modifiers": [
            "ctrl",
            "shift"
          ],
          "key": "c"
        }
      },
      "mode": "no-view"
    }
  ],
  "tools": [
    {
      "name": "get-paywall-free-url",
      "title": "Get Paywall-Free URL",
      "description": "Get a link to read an article using the preferred paywall removal service. Medium articles use Freedium.",
      "instructions": "Get a link to read an article through a paywall removal service.",
      "input": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "The full http or https URL of the article to read."
          }
        },
        "required": [
          "url"
        ]
      },
      "output": {
        "type": "string"
      },
      "confirmation": false
    }
  ],
  "platforms": [
    "macOS",
    "Windows"
  ],
  "preferences": [
    {
      "name": "service",
      "title": "Service",
      "description": "The default service to use to remove the paywall.",
      "type": "dropdown",
      "required": true,
      "data": [
        {
          "title": "Archive (archive.is)",
          "value": "https://archive.is"
        },
        {
          "title": "RemovePaywall (removepaywall.com)",
          "value": "https://www.removepaywall.com"
        },
        {
          "title": "Freedium (freedium-mirror.cfd)",
          "value": "https://freedium-mirror.cfd"
        }
      ]
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.104.3",
    "@raycast/utils": "^2.2.2"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.1.1",
    "@types/node": "22.13.10",
    "@types/react": "19.2.5",
    "eslint": "^9.39.2",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish",
    "type-check": "tsc --noEmit"
  },
  "ai": {
    "instructions": "When a user asks to read an article through a paywall removal service, use the get-paywall-free-url tool.\nReturn the link from the tool. Do not claim that access to the article is guaranteed.\n",
    "evals": [
      {
        "input": "@remove-paywall Get a link to read https://example.com/article",
        "mocks": {
          "get-paywall-free-url": "https://archive.is/https://example.com/article"
        },
        "expected": [
          {
            "callsTool": {
              "name": "get-paywall-free-url",
              "arguments": {
                "url": "https://example.com/article"
              }
            }
          },
          {
            "includes": "https://archive.is/https://example.com/article"
          }
        ]
      },
      {
        "input": "@remove-paywall Remove the paywall from https://medium.com/example/story",
        "mocks": {
          "get-paywall-free-url": "https://freedium-mirror.cfd/https://medium.com/example/story"
        },
        "expected": [
          {
            "callsTool": {
              "name": "get-paywall-free-url",
              "arguments": {
                "url": "https://medium.com/example/story"
              }
            }
          },
          {
            "includes": "https://freedium-mirror.cfd/https://medium.com/example/story"
          }
        ]
      }
    ]
  }
}